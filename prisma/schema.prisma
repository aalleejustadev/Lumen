// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7 reads the connection URL from prisma7.config.ts, not from here —
// the CLI gets Neon's direct endpoint, the app gets the pooled one.

datasource db {
  provider = "postgresql"
}

/// Placeholder so the first migration has something to create. Swap it for the
/// real models (courses, enrolments, …) as those land.

model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  interest  Interest @default(LEARNING)
  createdAt DateTime @default(now())

  @@map("waitlist_signups")
}

enum Interest {
  LEARNING
  TEACHING
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  // `user.additionalFields.intent` in lib/auth.ts — LEARNING | TEACHING
  intent        String?   @default("LEARNING")
  sessions      Session[]
  accounts      Account[]
  // Populated once a TEACHING user actually publishes something — nullable
  // both ways round, since neither direction exists yet.
  coursesTaught Course[]

  @@unique([email])
  @@map("user")
}

/// Browse Courses catalog (`/dashboard/courses`). The page itself still reads
/// `lib/config/browse-courses.ts` — there's no instructor-authoring flow yet
/// to populate this for real — but the table is shaped for what that flow
/// will need, so the page can swap its data source later without a schema
/// change. `instructorName` stands in for a display name until courses are
/// actually authored by a `User` (`instructorId` is nullable for exactly that
/// reason); `priceCents`/`listPriceCents` avoid float rounding on money.
model Course {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  instructorName String
  instructorId   String?
  instructor     User?          @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  category       CourseCategory
  level          CourseLevel
  durationHours  Int
  rating         Float          @default(0)
  reviewsCount   Int            @default(0)
  priceCents     Int
  listPriceCents Int
  /// Instructor-uploaded art, once that feature exists. Null renders the
  /// per-category gradient + icon placeholder — see `lumen-course-card-art`.
  thumbnailUrl   String?
  published      Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([category])
  @@index([instructorId])
  @@map("course")
}

enum CourseCategory {
  WEB_DEV
  DESIGN
  DATA_AI
  BUSINESS
  MARKETING
  FINANCE
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  // `issuer` is required by better-auth 1.7's account key (issuer + accountId
  // identify a provider account). @better-auth/cli only publishes up to 1.4.21
  // and omits it, so this model is maintained against the field list in
  // @better-auth/core/dist/db/get-tables.mjs — check there after upgrades.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}
