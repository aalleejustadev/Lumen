# ---------------------------------------------------------------------------
# Neon Postgres
#
# Both strings come from the Neon dashboard (project > Connect). They differ
# only in the endpoint host — the pooled one carries the `-pooler` suffix:
#
#   DATABASE_URL   pooled (PgBouncer)   the app's queries, via lib/db.ts
#   DIRECT_URL     direct / unpooled    prisma migrate, db push, studio
#
# Migrations over the pooled endpoint fail in ways that never mention pooling
# ("prepared statement \"s0\" already exists"), which is why the CLI is pointed
# at the direct URL in prisma7.config.ts.
#
# If you use the Neon CLI instead, `neon env pull` writes the direct one as
# DATABASE_URL_UNPOOLED — copy that value into DIRECT_URL.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ===========================================================================
# Better Auth
# ===========================================================================
#
# BETTER_AUTH_SECRET  Signs sessions and cookies. 32+ characters, generated
#                     with: openssl rand -base64 32
#                     Better Auth refuses placeholder/short secrets in
#                     production. Changing it logs everyone out.
# BETTER_AUTH_URL     The origin this app is served from, no trailing slash.
#                     OAuth callbacks and email links are built from it, so on
#                     a deploy it must be the real https:// domain.
#
BETTER_AUTH_SECRET="run: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Extra origins allowed to call /api/auth — comma-separated, no spaces.
# BETTER_AUTH_URL is trusted automatically; this is only for preview deploys or
# a separate front-end domain. Safe to leave empty locally.
BETTER_AUTH_TRUSTED_ORIGINS=""

# --- Google sign-in -------------------------------------------------------
# console.cloud.google.com → APIs & Services → Credentials → Create
# credentials → OAuth client ID → Web application.
# Authorised redirect URI (add one per environment, exactly):
#   http://localhost:3000/api/auth/callback/google
# Leave both blank and Google sign-in simply stays switched off.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- GitHub sign-in -------------------------------------------------------
# github.com/settings/developers → New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# The client secret is shown once, at creation. Blank = GitHub stays off.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Resend (verification + password-reset email) -------------------------
# resend.com/api-keys → Create API key (sending permission is enough).
# While RESEND_API_KEY is empty, emails are printed to the server console with
# their links intact — good enough to test the flows locally, and a hard error
# in production rather than a silently dropped message.
# EMAIL_FROM needs a domain verified at resend.com/domains. The shared
# onboarding@resend.dev sender works without one, but only delivers to the
# email address that owns the Resend account.
RESEND_API_KEY=""
EMAIL_FROM="Lumen <onboarding@resend.dev>"

# ===========================================================================
# Stripe (checkout)
# ===========================================================================
#
# dashboard.stripe.com/apikeys, or, with no account at all:
#   npm i -g @stripe/cli && stripe sandbox create
# which provisions a throwaway test environment and prints a key pair.
#
# STRIPE_SECRET_KEY
#   Prefer a RESTRICTED key (`rk_test_…` / `rk_live_…`) over a secret key
#   (`sk_…`). Stripe recommends restricted keys as the default: this app only
#   needs write on Checkout Sessions and read on Payment Intents, and a key
#   scoped to that can do far less damage if it leaks. Never commit a real
#   value — this file documents the names, `.env` holds them, and on a host
#   with a secrets vault the key belongs there rather than in an env var
#   (on Vercel, mark it a Sensitive environment variable).
#
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#   The browser half of the pair (`pk_test_…`). Public by design — it is what
#   `components/checkout/checkout-payment.tsx` initialises Stripe.js with.
#
# Leave both blank and the app still boots: /checkout says checkout isn't
# configured instead of throwing, the same way blank OAuth keys leave social
# sign-in switched off.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# STRIPE_WEBHOOK_SECRET
#   Signing secret for /api/stripe/webhook, which is where orders are actually
#   fulfilled — not the return page, which a paying customer is never
#   guaranteed to load. Get one for local development with:
#     stripe listen --forward-to localhost:3000/api/stripe/webhook
#   and in production from the endpoint's page in the Stripe Dashboard.
#   Events are rejected unsigned, so without this nothing is ever fulfilled.
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Neon Object Storage — profile avatars
# ---------------------------------------------------------------------------
# The `lumen-avatars` bucket backs the "Upload image" button on
# /dashboard/settings/profile (see lib/storage.ts). It is S3-compatible, so
# these are the AWS SDK's own variable names; the AWS SDK would find them in
# the environment on its own, but lib/storage.ts reads them explicitly so a
# blank set can be reported as "uploads aren't configured" instead of failing
# later with an opaque signing error.
#
# Storage is **branch-scoped** and branches with the database: each Neon
# branch has its own endpoint, its own credential and its own copy-on-write
# view of the objects. So don't copy these between environments — pull the
# branch's own set:
#
#   npx neonctl@latest buckets create lumen-avatars \
#     --access-level public_read --branch <branch>
#   npx neonctl@latest env pull --service object-storage --file .env
#
# `env pull` only rewrites the Neon variables and leaves the rest of the file
# alone. Public-read, because an avatar is rendered by the sidebar, the app
# bar and the account menu on every dashboard view — a presigned URL would
# have to be re-signed on each render and would defeat the HTTP cache.
#
# Only available in us-east-2 while Object Storage is in public beta. Leave
# these blank and the page still works; the upload button reports that it
# isn't configured.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION="us-east-2"

# NEON_BRANCH
#   Written by `neonctl env pull` — the branch the variables above came from.
#   Nothing reads it; it is there so a stale .env is recognisable.
NEON_BRANCH=""
